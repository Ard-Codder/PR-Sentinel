# Fine-grained PAT: Pull requests Read and write on the repositories below.
# Metadata Read is added by GitHub automatically. Do not grant Contents or Issues.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Comma-separated owner/repo. Empty: repositories already granted to the token, capped by the client.
GITHUB_REPOS=

# LM Studio on this machine. 192.168.3.5:1234 was not reachable here.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3-coder-30b-a3b-instruct
LLM_TIMEOUT_SECONDS=180
GITHUB_TIMEOUT_SECONDS=30

POLL_INTERVAL_SECONDS=120
MAX_PATCH_CHARS=80000
MAX_FILE_PATCH_CHARS=20000
MAX_CHUNKS=4
MAX_PRS_PER_CYCLE=5
MAX_REPOS=20
DATABASE_PATH=./data/state.db
REVIEW_LANGUAGE=ru
# Safe default: log the review and do not write to GitHub.
DRY_RUN=true
MAX_FINDINGS=20
MAX_MESSAGE_CHARS=2000
IN_PROGRESS_TIMEOUT_MINUTES=30
